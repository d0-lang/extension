{"tStartMs":247740,"dDurationMs":3530,"segs":[{"utf8":"リレーは機械と電気の組み合わせでできているわけですが"}]},
{"tStartMs":251270,"dDurationMs":850,"segs":[{"utf8":"動作するときに"}]},
{"tStartMs":252120,"dDurationMs":3590,"segs":[{"utf8":"やはりそれぞれの要素の特徴のようなものがあります"}]},
{"tStartMs":255710,"dDurationMs":1600,"segs":[{"utf8":"それを実際に見ていきます"}]},
