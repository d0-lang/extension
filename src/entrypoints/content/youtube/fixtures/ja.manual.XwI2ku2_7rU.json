{"tStartMs":277700,"dDurationMs":2980,"segs":[{"utf8":"6V、そして7V"}]},
{"tStartMs":280680,"dDurationMs":3740,"segs":[{"utf8":"定格電圧より低い電圧でリレーがONしました"}]},
{"tStartMs":284420,"dDurationMs":2160,"segs":[{"utf8":"ちょうど7V付近で接点が"}]},
