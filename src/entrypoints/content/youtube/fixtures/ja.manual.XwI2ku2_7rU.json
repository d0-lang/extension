{"tStartMs":127950,"dDurationMs":2540,"segs":[{"utf8":"電気回路ができて電流が流れる"}]},
{"tStartMs":130490,"dDurationMs":3450,"segs":[{"utf8":"接点を離すと電気回路がオープンな状態になって"}]},
{"tStartMs":133940,"dDurationMs":1220,"segs":[{"utf8":"電流は流れない"}]},
