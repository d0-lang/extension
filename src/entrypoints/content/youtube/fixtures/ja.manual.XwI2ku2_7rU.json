{"tStartMs":184670,"dDurationMs":2630,"segs":[{"utf8":"接点の部分はこのように動きます"}]},
{"tStartMs":187300,"dDurationMs":4320,"segs":[{"utf8":"この線を電源に繋ぐとコイルに電流が流れます"}]},
{"tStartMs":193470,"dDurationMs":1690,"segs":[{"utf8":"コイルに電流が流れると"}]},
{"tStartMs":195160,"dDurationMs":1660,"segs":[{"utf8":"こちらの接点が繋がって"}]},
{"tStartMs":196820,"dDurationMs":2850,"segs":[{"utf8":"そして負荷に電流が流れます"}]},
{"tStartMs":203140,"dDurationMs":1390,"segs":[{"utf8":"もうちょっと詳しく見てみると"}]},
