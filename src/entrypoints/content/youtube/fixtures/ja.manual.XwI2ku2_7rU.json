{"tStartMs":143710,"dDurationMs":1940,"segs":[{"utf8":"リレーが動作するわけですが"}]},
{"tStartMs":145650,"dDurationMs":1610,"segs":[{"utf8":"では実際このスプーンを"}]},
{"tStartMs":147260,"dDurationMs":2240,"segs":[{"utf8":"どうやって動かす必要があるのか"}]},
{"tStartMs":149500,"dDurationMs":1560,"segs":[{"utf8":"そこが重要です"}]},
{"tStartMs":151060,"dDurationMs":3970,"segs":[{"utf8":"実際に人間がこのように手で動かすわけにもいきません"}]},
{"tStartMs":155030,"dDurationMs":3930,"segs":[{"utf8":"そんなわけでリレーにはもう一つ重要な部品があります"}]},
{"tStartMs":158960,"dDurationMs":1360,"segs":[{"utf8":"それは何かというと"}]},
{"tStartMs":160320,"dDurationMs":2250,"segs":[{"utf8":"コイルを使った電磁石です"}]},
{"tStartMs":162570,"dDurationMs":3310,"segs":[{"utf8":"こんな感じで鉄心にコイルを巻いてみました"}]},
{"tStartMs":165880,"dDurationMs":2840,"segs":[{"utf8":"このように電磁石に電流を流していないと"}]},
{"tStartMs":168720,"dDurationMs":1780,"segs":[{"utf8":"全くくっつきませんが"}]},
{"tStartMs":170500,"dDurationMs":4480,"segs":[{"utf8":"電流を流すと非常に強力な電磁石になります"}]},
{"tStartMs":174980,"dDurationMs":3050,"segs":[{"utf8":"この電磁石による磁気吸引力を使って"}]},
{"tStartMs":178030,"dDurationMs":1970,"segs":[{"utf8":"引っ張り上げるわけです"}]},
{"tStartMs":180000,"dDurationMs":1620,"segs":[{"utf8":"実際に試してみます"}]},
