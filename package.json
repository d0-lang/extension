    "@lucide/svelte": "^1.67.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.4",
    "bits-ui": "^2.20.0",
    "cn": "^0.3.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.1.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
